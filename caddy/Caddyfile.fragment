# Fragment: in /Users/florianreisinger/dev/caddyfile/Caddyfile einfuegen,
# dann dort ./sync.sh (validate + reload). Nicht als eigenes Caddyfile nutzen.
# Voraussetzung: Portainer-Stack code-auth laeuft (Name code-auth, :8081 im webnet),
# SSH-Tunnel Mac -> VPS lauscht auf 127.0.0.1:18731 (siehe run.sh).
code.all-the.rest {
	import security_headers
	import compress

	# statische Login-Seite (via rclone aus apps/web/dist synchronisiert)
	handle /login.html {
		root * /srv/websites/code.all-the.rest
		file_server
	}

	# Login-API an Sidecar (setzt HMAC-Cookie)
	handle /api/login {
		reverse_proxy code-auth:8081
	}
	handle /api/me {
		reverse_proxy code-auth:8081
	}
	handle /api/logout {
		reverse_proxy code-auth:8081
	}

	# alles andere: Cookie pruefen, dann SSH-Tunnel zum Mac
	handle {
		forward_auth code-auth:8081 {
			uri /check
			copy_headers Remote-User
		}
		reverse_proxy 127.0.0.1:18731
	}

	# nie 401 mit WWW-Authenticate -> nie natives Browser-Popup
	handle_errors {
		@auth401 expression `{err.status_code} == 401`
		redir @auth401 /login.html 302
	}
}
